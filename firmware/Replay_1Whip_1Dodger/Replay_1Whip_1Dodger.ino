/*
 * Replay_1Whip_1Dodger.ino
 *
 * Plays back the "1Whip_1Dodger" protocol capture from
 * npjg/radica-cube-world-hack, decoded live through the CubeWorld
 * protocol library and rendered on the Waveshare 1.54inch Touch LCD.
 *
 * Session: one cube (the Arduino probe, id 0x01) whips "Dodger":
 *   HELLO handshake -> keepalives (ids 0x0e/0x0c) -> two WHIP actions
 *   -> BYE -> END.
 *
 * The replay table (replay_data.h) is generated by tools/gen_replays.py
 * from the raw capture annotations; the whole ~63 s capture plays in
 * ~15 s. Touch the screen to (re)start.
 */
#include <OpenCubeWorld.h>
#include "replay_data.h"

static Arduino_GFX *gfx;
static ocw::World world(nullptr);

static bool playing = false;
static uint32_t t0 = 0;
static int idx = 0;

static void monitor(const uint8_t p[7]) {
  world.lastPacket = p;
  world.lastPacketAt = millis();
}

static void handlePacket(const uint8_t p[7]) {
  monitor(p);
  switch (CubeProtocol::type(p)) {
    case CW_TYPE_HELLO:     world.onHello(CubeProtocol::id(p)); break;
    case CW_TYPE_KEEPALIVE: world.onKeepalive(CubeProtocol::slot(p), CubeProtocol::id(p)); break;
    case CW_TYPE_ACTION:    world.onWhip(p[1], p[2], p[3], CubeProtocol::id(p), 120, 140); break;
    case CW_TYPE_BYE:       world.onBye(CubeProtocol::id(p)); break;
    case CW_TYPE_END:       world.onEnd(CubeProtocol::id(p)); break;
    default: break;
  }
}

void setup() {
  Serial.begin(115200);
  gfx = ocwCreateDisplay();
  gfx->begin();
  ocwBacklightOn();
  cst816d_init(OCW_TP_RST_PIN, -1);
  world = ocw::World(gfx);
  world.begin();
  world.setup(3);
  world.session = ocw::SESS_ACTIVE;  // replay drives its own lifecycle
  Serial.println("OpenCubeWorld replay: " OCW_REPLAY_NAME);
}

static bool touchEvent() {
  static uint32_t last = 0;
  touch_data_t td;
  if (!get_touch_data(&td) || td.touch_num == 0) return false;
  uint32_t now = millis();
  if (now - last < 400) return false;
  last = now;
  return true;
}

void loop() {
  uint32_t now = millis();

  if (!playing) {
    world.session = ocw::SESS_BOOT;
    world.drawBoot(now);
    // caption
    gfx->setTextColor(ocw::COL_ACCENT);
    gfx->setCursor(60, 176);
    gfx->print("REPLAY: " OCW_REPLAY_NAME);
    if (touchEvent()) {
      playing = true;
      t0 = millis();
      idx = 0;
      world.setup(3);
      world.session = ocw::SESS_ACTIVE;
      world.lastPacket = nullptr;
    }
    return;
  }

  // scaled elapsed time: display_us * DEN/NUM  (capture plays in ~15 s)
  uint64_t elapsed_us = (uint64_t)(now - t0) * 1000 * OCW_REPLAY_SCALE_DEN / OCW_REPLAY_SCALE_NUM;
  while (idx < OCW_REPLAY_N) {
    uint32_t t = 0;
#if defined(__AVR__)
    t = pgm_read_dword(&((uint32_t *)ocw_replay)[idx * 2]);
#else
    t = ocw_replay[idx].t_us;
#endif
    if (t > elapsed_us) break;
    uint8_t p[7];
    for (int i = 0; i < 7; i++) {
#if defined(__AVR__)
      p[i] = pgm_read_byte(&ocw_replay[idx].p[i]);
#else
      p[i] = ocw_replay[idx].p[i];
#endif
    }
    handlePacket(p);
    idx++;
  }

  world.update(now);
  world.draw();
  // progress tick in the top bar (replaces the session label)
  gfx->setTextColor(ocw::COL_GREEN);
  gfx->setCursor(204, 3);
  gfx->print((idx * 100) / OCW_REPLAY_N > 99 ? "100%" : " " + String(idx * 100 / OCW_REPLAY_N) + "%");

  if (idx >= OCW_REPLAY_N && now > world.lastPacketAt + 2500) {
    playing = false;
    world.resetToBoot();
  }
  delay(40);
}
